<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net11.0-android37.0</TargetFramework>
		<SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
		<OutputType>Exe</OutputType>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationId>com.companyname.SampleShowAd</ApplicationId>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<IsPackable>false</IsPackable>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\VpnHood.AppLib.Ads.InMobi.Android\VpnHood.AppLib.Ads.InMobi.Android.csproj" />
	</ItemGroup>

	<!-- The ad ids, one value per file in the private .user folder beside this repo
	     (.user/ad/InMobi): embedded by file name, never in git. -->
	<PropertyGroup>
		<VhUserDir Condition="'$(VhUserDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\.user</VhUserDir>
	</PropertyGroup>
	<ItemGroup>
		<EmbeddedResource Include="$(VhUserDir)\ad\InMobi\*.txt" LogicalName="%(Filename)%(Extension)" Visible="false" />
	</ItemGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<PublishTrimmed>True</PublishTrimmed>
		<RunAOTCompilation>True</RunAOTCompilation>
		<RuntimeIdentifiers>android-x64</RuntimeIdentifiers>
	</PropertyGroup>

</Project>